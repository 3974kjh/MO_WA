PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key

# App runtime may use a hosted Supabase project. DB migration/validation scripts do NOT.
# Local BE-01 validation ignores DATABASE_URL and uses MOWA_DB_* only:
#   MOWA_DB_HOST=127.0.0.1
#   MOWA_DB_PORT=5432
#   MOWA_DB_USER=postgres
#   MOWA_DB_PASSWORD=postgres
#   MOWA_DB_NAME=mowa_local
#   pnpm db:local:up
#   MOWA_ALLOW_GATED_TEST=1 pnpm test:db
# Do not point test:db / db:migrate --apply at remote, staging, or production.

# --- Cloudflare Pages ---
# 환경 변수는 Dashboard → Settings → Environment variables 에서만 설정
# (wrangler.jsonc에 vars/pages_build_output_dir 넣으면 Dashboard가 잠김)
# Local preview secrets: copy .dev.vars.example → .dev.vars
